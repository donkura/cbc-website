<IfModule mod_headers.c>
  # Prevent browser caching of HTML files so updates display immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  
  # Cache static media assets
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|mp4|webm|woff|woff2)$">
    Header set Cache-Control "max-age=604800, public"
  </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
  # Instruct Hostinger LiteSpeed server to bypass HTML cache
  CacheLookup off
</IfModule>
