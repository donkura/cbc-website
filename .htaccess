DirectoryIndex index.html index.htm

# Prevent directory indexing/browsing
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ensure LiteSpeed and proxy caches do not store HTML responses
  RewriteCond %{REQUEST_URI} .(html|htm)$ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/$ [NC]
  RewriteRule .* - [E=Cache-Control:no-cache]

  # If a directory is requested with a trailing slash and index.html exists, serve it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule [^/]$ %{REQUEST_URI}/ [R=301,L]

  # If an .html file exists for the requested path, serve it
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Aggressive cache-busting for HTML & dynamic documents so clients always see the latest edits
  <FilesMatch "\.(html|htm|txt|json)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
  
  # Static media asset caching (images, fonts, videos)
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|mp4|webm|woff|woff2)$">
    Header set Cache-Control "max-age=604800, public"
  </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
  # Disable LiteSpeed server-side page caching for fresh HTML updates
  CacheLookup off
</IfModule>
